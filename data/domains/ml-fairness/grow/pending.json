 "entries": [
  {
   "wid": "W7222568097",
   "openalex_id": "https://openalex.org/W7222568097",
   "title": "How Algorithmic Bias Shapes Consumer Acceptance of AI Recommendations: The Roles of Recommendation Strategy, Self\u2010Identity Threat, Perceived Warmth and Privacy Concerns",
   "year": 2026,
   "doi": "https://doi.org/10.1111/ijcs.70272",
   "venue": "International Journal of Consumer Studies",
   "field": "social sciences",
   "cited_by_count": 0,
   "abstract": "ABSTRACT Algorithmic bias, as a socio\u2010technical phenomenon, may produce discriminatory outcomes that violate norms of justice and equality, thereby adversely affecting specific groups in society. Although algorithmic fairness has received widespread attention, how different recommendation strategies interact with algorithmic bias to influence consumers' psychological responses in intelligent recommendation scenarios remains underexplored. Grounded in identity process theory, this study focuses on two recommendation strategies (relevance\u2010based vs. similarity\u2010based recommendations) to examine the impact of algorithmic bias on consumers' recommendation acceptance intention, and further analyzes the moderating roles of perceived warmth and privacy concerns. Through four experimental studies (total N = 895), we find that algorithmic bias reduces consumers' acceptance intention, and this effect is more pronounced under similarity\u2010based (vs. relevance\u2010based) recommendation strategies. Perceived warmth and privacy concerns moderate the mediation pathway of self\u2010identity threat, such that relevance\u2010based recommendations (vs. similarity\u2010based recommendations) enhance recommendation acceptance intention by reducing self\u2010identity threat. These findings reveal that similarity\u2010based recommendations may exacerbate user resistance in the context of algorithmic bias. This study deepens the theoretical understanding of the psychological mechanisms underlying algorithmic unfairness in the digital age, extends the application of identity process theory to the domain of human\u2010computer interaction, and provides actionable empirical implications for enterprises in the ethical design and strategic optimization of intelligent recommendation systems.",
   "label": "on-domain",
