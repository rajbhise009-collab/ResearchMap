 "entries": [
  {
   "wid": "W4386392053",
   "openalex_id": "https://openalex.org/W4386392053",
   "title": "An accuracy self-nudge to reduce misinformation sharing online.",
   "year": 2026,
   "doi": "https://doi.org/10.1037/tmb0000221",
   "venue": "Technology Mind and Behavior",
   "field": "social sciences",
   "cited_by_count": 1,
   "abstract": "Self-nudging interventions enable people to redesign their own environment to encourage choices that are in line with their goals and preferences. Self-nudging is particularly relevant online, where users\u2019 autonomy is endangered by deceptive design and opaque algorithms. To date, experimental research on self-nudging interventions to confront online challenges is scarce. In this pre-registered experimental study (N = 965), participants in the self-nudge condition were informed about a nudge to reduce misinformation sharing and actively decided for or against its implementation during the study; participants in the nudge condition received the nudge without such information nor the option to choose. Both the self-nudge and the nudge increased sharing discernment, but the effect of the self-nudge was stronger. Beside developing an experimental methodology to test self-nudging in a controlled setting, this study provides evidence for the potential of self-nudging to avoid paternalism in the application of behavioral interventions online, without compromising on effectiveness.",
   "label": "on-domain",
   "rationale": "strong term in title: 'nudge' + pair anywhere: 'choices'; core scope: same sentence: 'nudg' + 'choices'",
