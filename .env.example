# === ResearchMap environment ===
# Copy to .env and fill in values. .env is gitignored.
# The offline seed pipeline runs with NONE of these set.

# --- Database ---
# Plain local Postgres or Supabase-compatible URL.
# pgvector extension must be installed on the database.
DATABASE_URL=

# --- LLM providers (used only in Phase 2+) ---
# Extraction (structured decomposition of paper text).
GEMINI_API_KEY=
# Extraction model. Validated against models.list at client startup.
# Model names are volatile — a deprecated one fails loudly rather than
# 404-ing mid-run. Default (if unset) is gemini-flash-latest.
GEMINI_MODEL=gemini-3.6-flash
# Synthesis (opportunity explanations in later phases).
ANTHROPIC_API_KEY=

# --- Literature sources ---
# OpenAlex API key. MANDATORY for live calls since 2026-02-13, when
# OpenAlex retired the polite-pool mailto convention. Free keys at
# https://openalex.org/settings/api. If unset, ingestion falls back
# to the offline seed corpus and does NOT hit the network.
OPENALEX_API_KEY=
# Semantic Scholar API key (optional; unauthenticated is rate-limited).
SEMANTIC_SCHOLAR_API_KEY=

# --- Runtime ---
# One of: development | test | production
RESEARCHMAP_ENV=development
# Directory of the committed offline sample corpus.
SEED_DIR=data/seed
# Per-paper extraction cache directory.
CACHE_DIR=data/cache
