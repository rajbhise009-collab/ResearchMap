# Env / secrets
.env
.env.*
!.env.example

# Blind-review answer key — must stay out of the public tree.
# Written locally by `python -m backend.app.review.build_diet_packet`
# to `~/ResearchMap-private/answer_key.json`. See
# docs/review/diet-contradictions/README.md for the scorer wiring.
docs/review/diet-contradictions/_answer_key_DO_NOT_SHARE/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Cache (per-paper extractions and cached API responses — regenerable)
data/cache/

# Phase 4 corpus dumps — large, regeneratable from the manifest
data/corpora/

# Raw OpenAlex JSON pulls — large, regeneratable from the diagnostic script
data/live_samples/

# Hand-labelled reviewer CSVs — user's private work
data/labelled/*.filled.csv

# DB artifacts
*.db
*.sqlite
*.sqlite3

# Scratch — one-off proof runs, sample dumps, debugging output.
# Never committed. Regenerate any file in here from the script that
# produced it.
scratch/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Node (frontend, later phase)
node_modules/
.next/

# Generated reasoning/relationship artifacts (regenerable — the shipped
# snapshot at frontend/public/data/ IS committed, so public deploys build
# from source without needing to regenerate reasoning first).
data/reasoning/
data/relationships/

# Multi-domain snowball raw records — large (18MB diet + 15MB fairness),
# regeneratable via `python -m backend.app.corpus.multi_domain --domain
# <slug> --stage snowball`. Everything downstream (prelabelled.json,
# audit_sample.md, reasoning/) IS committed.
data/domains/*/snowball.json

# Frontend build outputs (regenerable). The snapshot at
# frontend/public/data/ is NOT ignored — see block above; it's the input
# that lets Vercel / GitHub Pages build without a Python step.
frontend/.next/
frontend/out/

frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts
.launcher.log
.shots-*/
resources/icon/*.iconset/
resources/icon/wrap.html
