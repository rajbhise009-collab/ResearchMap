#!/usr/bin/env bash
#
# ResearchMap.app — Finder-native launcher.
#
# Sits inside the repo it launches (ResearchMap/ResearchMap.app/). Runs
# silently: no Terminal window, native notifications for progress, native
# dialogs for errors. Dock icon stays visible for the app's lifetime;
# right-click → Quit (SIGTERM) shuts the local server down cleanly.
#
# The install/build/serve logic is shared with ResearchMap.command via
# scripts/rm-lib.sh — this file is just the macOS-native UI wrapping it.

set -u

# .../ResearchMap/ResearchMap.app/Contents/MacOS/ResearchMap
readonly EXEC_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly APP_BUNDLE="$(cd "$EXEC_DIR/../.." && pwd)"           # ResearchMap.app
REPO="$(dirname "$APP_BUNDLE")"                                # containing folder
export REPO

# All output goes to the log — there's no controlling terminal. Users see
# messages via osascript notification / dialog instead.
LOG_DIR="$HOME/Library/Logs/ResearchMap"
RM_LOG="$LOG_DIR/launcher.log"
mkdir -p "$LOG_DIR"
export RM_LOG
exec >>"$RM_LOG" 2>&1
echo "==== ResearchMap.app started at $(date) ===="
echo "APP_BUNDLE=$APP_BUNDLE"
echo "REPO=$REPO"

# --- preflight: TCC file-access check ----------------------------------
# On modern macOS (Ventura+), an app launched from Finder that sits in
# ~/Downloads, ~/Documents, or ~/Desktop is blocked from reading its own
# adjacent files unless the user grants "Files and Folders → Downloads"
# in System Settings. The failure is silent — the source command below
# would just fail with "Operation not permitted" and every rm_* function
# would be undefined. That's the "nothing happens" report.
#
# Test read access to the shared library up front and show a clear
# actionable dialog with three good options.
_lib="$REPO/scripts/rm-lib.sh"
if [ ! -r "$_lib" ] || ! cat "$_lib" >/dev/null 2>&1; then
  # Distinguish "missing" from "blocked" so the dialog says the right thing.
  parent_dir="$(basename "$(dirname "$REPO")")"
  case "$parent_dir" in
    Downloads|Documents|Desktop)
      # TCC-protected location. This is by far the most common cause.
      title="macOS is blocking ResearchMap.app"
      body="The app can't read its own files because it lives in your ${parent_dir} folder, which macOS treats as protected.

The fix (any one is fine):

  •  Move the whole ResearchMap folder to a non-protected location — e.g. drag it into ~/Applications, or your home folder (~).

  •  Or open Terminal and run:
        mv \"$REPO\" ~/ResearchMap

  •  Or grant permission in System Settings → Privacy & Security → Files and Folders → ResearchMap → enable ${parent_dir} Folder.

After moving or granting permission, double-click ResearchMap.app again."
      ;;
    *)
      title="ResearchMap.app can't read its own files"
      body="The app looks for its files here:
$REPO

If you moved just the .app out of the ResearchMap folder, put it back — the .app must sit inside the project folder.

If the whole folder is intact, macOS may be blocking file access. Try running ResearchMap.command from Terminal to see the exact error."
      ;;
  esac
  echo "[preflight FAIL] cannot read $_lib"
  osascript <<APPLESCRIPT >/dev/null 2>&1 || true
tell application "System Events"
  activate
  display dialog "$body" with title "$title" buttons {"Open Downloads folder", "OK"} default button 2 with icon stop
  if button returned of result is "Open Downloads folder" then
    do shell script "open $HOME/Downloads"
  end if
end tell
APPLESCRIPT
  exit 1
fi

# --- guardrail: the app must sit inside its repo ------------------------
if [ ! -d "$REPO/backend" ]; then
  osascript -e "display dialog \"ResearchMap.app must stay inside the ResearchMap project folder.\n\nThe app looks for its files at:\n$REPO\n\nMove the whole ResearchMap folder together, or run ResearchMap.command instead.\" with title \"ResearchMap\" buttons {\"OK\"} default button 1 with icon stop" >/dev/null 2>&1 || true
  exit 1
fi

# --- native UI shims for rm-lib.sh -------------------------------------
# `osascript display notification` shows a discreet macOS notification;
# `display dialog` shows a modal error users have to dismiss. The lib
# writes prose messages assuming a Terminal; we tag them for the log and
# only surface milestones + fatals to the user.
_notify() {
  # Escape double quotes for AppleScript.
  local msg="${1//\"/\\\"}"
  osascript -e "display notification \"$msg\" with title \"ResearchMap\"" 2>/dev/null || true
}
_dialog_error() {
  local title="${1//\"/\\\"}"
  local body="${2//\"/\\\"}"
  osascript -e "display dialog \"$body\" with title \"ResearchMap — $title\" buttons {\"Show log\", \"OK\"} default button 2 with icon stop" 2>/tmp/rm-dialog-result || true
  if grep -q "Show log" /tmp/rm-dialog-result 2>/dev/null; then
    open -R "$RM_LOG" 2>/dev/null || open "$RM_LOG" 2>/dev/null || true
  fi
  rm -f /tmp/rm-dialog-result
}

ui_step() { echo "[step] $*"; case "$*" in
    *"installing frontend"*) _notify "First run: installing frontend dependencies (30–90s)…" ;;
    *"installing"*|*"backend"*) _notify "First run: installing the Python backend (~30s)…" ;;
    *"Building"*)   _notify "Building the site (15–30s)…" ;;
esac; }
ui_ok()   { echo "[ok] $*"; }
ui_note() { echo "[note] $*"; }
ui_fail() {
  local title="$1"; local body="${2:-}"
  echo "[FAIL] $title"
  echo "$body"
  _dialog_error "$title" "$title

$body"
  exit 1
}

# --- setup + serve ------------------------------------------------------
# shellcheck disable=SC1091
. "$REPO/scripts/rm-lib.sh"

rm_check_prereqs
rm_install_frontend_deps
rm_ensure_python_env
rm_build_site
rm_start_server

# Native-window mode: Chrome --app=URL (chromeless, own Dock icon, feels
# like a real Mac app). Falls back to the default browser when Chrome
# isn't installed. The same URL still works in any browser tab — the log
# and dev-mode notification carry it for anyone who wants to share it.
rm_open window "$URL"
_notify "ResearchMap is running · also open at $URL"

# --- lifecycle: stay alive; clean up on quit ----------------------------
_shutdown() {
  echo "[shutdown] $(date)"
  rm_shutdown
  exit 0
}
# When the user quits from Dock (right-click → Quit) macOS sends SIGTERM
# to the app's executable. INT/HUP/EXIT are for defence in depth.
trap _shutdown TERM INT HUP EXIT

# Foreground-wait on the server keeps this exec alive → Dock icon stays
# visible for the entire session. Without the wait, we'd exit and macOS
# would remove the Dock icon while the backgrounded server kept running.
wait "$SERVER_PID"
